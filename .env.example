# Postgres connection string (Vercel Postgres injects POSTGRES_URL; DATABASE_URL also works).
# Locally: docker run -d --name topdown-pg -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=topdown -p 5432:5432 postgres:16
POSTGRES_URL=postgres://postgres:dev@localhost:5432/topdown

# LLM provider keys — used by the T0 public-web research engine.
# Fallback order: OpenRouter -> Perplexity -> Gemini -> labeled demo fixture.
OPENROUTER_API_KEY=
# Model used via OpenRouter (default: perplexity/sonar — has built-in web search)
OPENROUTER_MODEL=perplexity/sonar
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
EXA_API_KEY=
# Optional: Sumble structured org data (teams, job levels, LinkedIn URLs)
SUMBLE_API_KEY=
# Optional comma-separated order. Defaults to gemini,openrouter,perplexity.
LLM_PROVIDER_PRIORITY=

# CORS allow-list (comma-separated). Vercel previews (*.vercel.app) are always allowed.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 in production: SameSite=None;Secure session cookie (needed for cross-site preview origins).
COOKIE_SECURE=1

# Comma-separated accounts with platform-wide workspace access and Pro entitlements.
SUPER_ADMIN_EMAILS=

# Port for local API dev server (default: 8787)
PORT=
# Optional: point the web app at a non-same-origin API (e.g. a preview deployment)
VITE_API_URL=

# Calendar & email integrations (optional — without these the UI shows providers as Not configured).
# Google Cloud OAuth client (Calendar + Gmail metadata scopes).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra app registration (Calendars.Read + Mail.Read scopes).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# AES-256-GCM key for tokens at rest: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=
