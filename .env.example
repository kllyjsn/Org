# LLM provider keys — used by the T0 public-web research engine.
# At least one is required for live research; with neither set, the API
# serves a clearly-labeled demo fixture so the product still works.

# Preferred: OpenRouter routes requests to a configurable model.
OPENROUTER_API_KEY=
# Model used via OpenRouter (default: perplexity/sonar — has built-in web search)
OPENROUTER_MODEL=perplexity/sonar

# Fallback when OPENROUTER_API_KEY is unset: Perplexity sonar directly.
PERPLEXITY_API_KEY=

# SQLite file location (default: ./data/org.db)
DATABASE_PATH=

# Port for the API (default: 8787)
PORT=
