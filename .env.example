# MongoDB connection string (api uses database MONGODB_DB, default "topdown").
# On Vercel this is set as a project env var; locally put it in api/.env or export it.
MONGODB_URI=
MONGODB_DB=topdown

# LLM provider keys — used by the T0 public-web research engine.
# Fallback order: OpenRouter -> Perplexity -> Gemini -> labeled demo fixture.
OPENROUTER_API_KEY=
# Model used via OpenRouter (default: perplexity/sonar — has built-in web search)
OPENROUTER_MODEL=perplexity/sonar
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# CORS allow-list (comma-separated). Vercel previews (*.vercel.app) are always allowed.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 in production: SameSite=None;Secure session cookie (needed for cross-site preview origins).
COOKIE_SECURE=1

# Port for local API dev server (default: 8787)
PORT=
# Optional: point the web app at a non-same-origin API (e.g. a preview deployment)
VITE_API_URL=
