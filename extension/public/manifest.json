{
  "manifest_version": 3,
  "name": "TopDown for LinkedIn",
  "version": "0.1.0",
  "description": "Add the LinkedIn profile you're viewing, or a Sales Navigator lead list, to a TopDown account roster.",
  "action": {
    "default_title": "TopDown",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://api.topdown.sh/*"],
  "optional_host_permissions": ["http://localhost/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
